<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Government Services & Applications</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    .service-dashboard {
      min-height: 100vh;
      background: #f3f6fb;
      display: flex;
      color: #172b4d;
    }

    .service-sidebar {
      width: 230px;
      background: #102f52;
      color: white;
      padding: 20px 14px;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      box-sizing: border-box;
    }

    .service-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 8px 24px;
    }

    .service-brand-icon {
      font-size: 30px;
    }

    .service-brand h2 {
      margin: 0;
      font-size: 20px;
    }

    .service-brand p {
      margin: 3px 0 0;
      font-size: 11px;
      opacity: 0.75;
    }

    .service-nav {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .service-nav a {
      color: white;
      text-decoration: none;
      padding: 11px 12px;
      border-radius: 8px;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 10px;
      opacity: 0.9;
    }

    .service-nav a:hover,
    .service-nav a.active {
      background: #1d5d99;
      opacity: 1;
    }

    .service-sidebar-bottom {
      margin-top: auto;
    }

    .service-main {
      flex: 1;
      min-width: 0;
    }

    .service-topbar {
      height: 64px;
      background: white;
      border-bottom: 1px solid #e3e8ef;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      box-sizing: border-box;
    }

    .service-search {
      width: 420px;
      max-width: 50%;
      background: #f5f7fa;
      border: 1px solid #e3e8ef;
      border-radius: 8px;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 9px;
      color: #7b8798;
      box-sizing: border-box;
    }

    .service-search input {
      border: none;
      outline: none;
      background: transparent;
      width: 100%;
      font-size: 12px;
    }

    .service-user {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .service-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #e8f0fa;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .service-user strong {
      display: block;
      font-size: 13px;
    }

    .service-user small {
      color: #7b8798;
      font-size: 11px;
    }

    .service-content {
      padding: 20px 28px 30px;
    }

    .service-breadcrumb {
      font-size: 11px;
      color: #7b8798;
      margin-bottom: 16px;
    }

    .service-breadcrumb span {
      margin: 0 5px;
    }

    .service-page-header {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 12px;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 15px;
    }

    .service-title-area {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .service-title-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: #e9f3ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 27px;
    }

    .service-title-area h1 {
      margin: 0 0 5px;
      font-size: 20px;
    }

    .service-title-area p {
      margin: 0;
      font-size: 12px;
      color: #6c7a8c;
    }

    .service-secure-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #e5f7ed;
      color: #16834b;
      padding: 7px 12px;
      border-radius: 18px;
      font-size: 11px;
      font-weight: 600;
    }

    .service-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 16px;
    }

    .service-card {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 16px;
    }

    .service-card-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
    }

    .service-card-icon {
      width: 42px;
      height: 42px;
      background: #eef5ff;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 21px;
    }

    .service-card-header h2 {
      margin: 0 0 4px;
      font-size: 16px;
    }

    .service-card-header p {
      margin: 0;
      color: #718096;
      font-size: 11px;
    }

    .service-welcome {
      background: #f5f9ff;
      border: 1px solid #dfeafb;
      border-radius: 9px;
      padding: 13px 15px;
      margin-bottom: 18px;
    }

    .service-welcome h3 {
      margin: 0 0 4px;
      font-size: 14px;
    }

    .service-welcome p {
      margin: 0;
      color: #718096;
      font-size: 10px;
    }

    .service-form-group {
      margin-bottom: 15px;
    }

    .service-form-group label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      margin-bottom: 7px;
      color: #40516a;
    }

    .service-form-group select,
    .service-form-group input {
      width: 100%;
      box-sizing: border-box;
      padding: 11px 12px;
      border: 1px solid #d6dee9;
      border-radius: 7px;
      background: white;
      color: #26384f;
      font-size: 11px;
      outline: none;
    }

    .service-form-group select:focus,
    .service-form-group input:focus {
      border-color: #3b78bd;
      box-shadow: 0 0 0 2px rgba(59, 120, 189, 0.08);
    }

    .service-form-group input[readonly] {
      background: #f6f8fb;
      color: #52657e;
    }

    .service-details {
      margin-top: 5px;
    }

    .verified-information {
      border: 1px solid #dfe7f0;
      border-radius: 10px;
      overflow: hidden;
      margin-top: 20px;
    }

    .verified-header {
      padding: 15px;
      background: #f8fafc;
      border-bottom: 1px solid #e5eaf0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .verified-header h2 {
      margin: 0 0 4px;
      font-size: 14px;
    }

    .verified-header p {
      margin: 0;
      color: #718096;
      font-size: 10px;
    }

    .verified-badge {
      background: #e5f7ed;
      color: #16834b;
      padding: 6px 10px;
      border-radius: 15px;
      font-size: 10px;
      font-weight: 600;
      white-space: nowrap;
    }

    .verified-body {
      padding: 4px 15px;
    }

    .verified-row {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding: 11px 0;
      border-bottom: 1px solid #edf0f4;
    }

    .verified-row:last-child {
      border-bottom: none;
    }

    .verified-label {
      color: #718096;
      font-size: 10px;
    }

    .verified-value {
      color: #26384f;
      font-size: 10px;
      font-weight: 600;
      text-align: right;
    }

    .consent-preview {
      margin-top: 16px;
      padding: 13px;
      background: #f1faf5;
      border: 1px solid #d8eddf;
      border-radius: 9px;
      display: flex;
      gap: 11px;
      align-items: flex-start;
    }

    .consent-preview-icon {
      width: 34px;
      height: 34px;
      background: #e1f4e8;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .consent-preview h3 {
      margin: 0 0 4px;
      font-size: 12px;
    }

    .consent-preview p {
      margin: 0;
      color: #64748b;
      font-size: 10px;
      line-height: 1.5;
    }

    .service-submit {
      width: 100%;
      border: none;
      background: #2365b5;
      color: white;
      padding: 12px;
      border-radius: 7px;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 15px;
    }

    .service-submit:hover {
      background: #1c5597;
    }

    .side-card h3 {
      margin: 0 0 14px;
      font-size: 14px;
    }

    .side-info-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 9px 0;
      border-bottom: 1px solid #edf0f4;
    }

    .side-info-row:last-child {
      border-bottom: none;
    }

    .side-info-row span {
      color: #718096;
      font-size: 10px;
    }

    .side-info-row strong {
      font-size: 10px;
      text-align: right;
    }

    .side-info-box {
      background: #eef6ff;
      border: 1px solid #d7e9fb;
      border-radius: 9px;
      padding: 11px;
      color: #526b86;
      font-size: 10px;
      line-height: 1.5;
    }

    .side-consent {
      background: #f1faf5;
      border-color: #d8eddf;
    }

    .side-consent-badge {
      display: inline-block;
      background: #e1f4e8;
      color: #16834b;
      padding: 5px 9px;
      border-radius: 14px;
      font-size: 10px;
      font-weight: 600;
      margin-bottom: 9px;
    }

    .side-consent p {
      margin: 0 0 12px;
      color: #64748b;
      font-size: 10px;
      line-height: 1.5;
    }

    .side-button {
      display: block;
      text-align: center;
      text-decoration: none;
      color: #2365b5;
      border: 1px solid #b9c8da;
      border-radius: 7px;
      padding: 9px;
      font-size: 10px;
      font-weight: 600;
    }

    .service-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 10px;
      padding: 12px 16px;
    }

    .service-security {
      color: #68778d;
      font-size: 10px;
    }

    .service-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      color: white;
      background: #2365b5;
      padding: 10px 16px;
      border-radius: 7px;
      font-size: 11px;
      font-weight: 600;
    }

    @media (max-width: 900px) {
      .service-sidebar {
        width: 190px;
      }

      .service-layout {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .service-dashboard {
        display: block;
      }

      .service-sidebar {
        width: 100%;
        min-height: auto;
      }

      .service-nav {
        flex-direction: row;
        flex-wrap: wrap;
      }

      .service-sidebar-bottom {
        margin-top: 10px;
      }

      .service-topbar {
        padding: 0 15px;
      }

      .service-search {
        max-width: 60%;
      }

      .service-content {
        padding: 15px;
      }

      .service-page-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .verified-row {
        flex-direction: column;
        gap: 4px;
      }

      .verified-value {
        text-align: left;
      }

      .service-bottom {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>

  <div class="service-dashboard">

    <aside class="service-sidebar">

      <div class="service-brand">

        <div class="service-brand-icon">
          🏛️
        </div>

        <div>
          <h2>BharatSetu</h2>
          <p>One Citizen. One Platform.</p>
        </div>

      </div>

      <nav class="service-nav">

        <a href="/dashboard?nationalId=<%= citizen.nationalId %>">
          🏠
          Home
        </a>

        <a href="/dashboard?nationalId=<%= citizen.nationalId %>#government-portals">
          🏛️
          Government Portals
        </a>

        <a href="/services?nationalId=<%= citizen.nationalId %>" class="active">
          📄
          Services & Applications
        </a>

        <a href="/portal/applicationStatus?nationalId=<%= citizen.nationalId %>">
          🕒
          Application History
        </a>

        <a href="#">
          ☑️
          Eligibility Checker
        </a>

        <a href="#">
          📁
          Document Reuse
        </a>

        <a href="#">
          🛡️
          Consent Management
        </a>

        <a href="#">
          🔍
          Grievance Management
        </a>

        <a href="#">
          🔔
          Notifications
        </a>

      </nav>

      <div class="service-sidebar-bottom">

        <a href="/login" class="service-nav">
          <span>🚪 Logout</span>
        </a>

      </div>

    </aside>

    <main class="service-main">

      <header class="service-topbar">

        <div class="service-search">
          🔍
          <input
            type="text"
            placeholder="Search for services, schemes, certificates..."
          >
        </div>

        <div class="service-user">

          <div class="service-avatar">
            👤
          </div>

          <div>

            <strong>
              <%= citizen.identity.fullName %>
            </strong>

            <small>
              Citizen
            </small>

          </div>

        </div>

      </header>

      <div class="service-content">

        <div class="service-breadcrumb">
          Home
          <span>›</span>
          Services & Applications
        </div>

        <section class="service-page-header">

          <div class="service-title-area">

            <div class="service-title-icon">
              📄
            </div>

            <div>

              <h1>
                Government Services & Applications
              </h1>

              <p>
                Select a government service and continue with verified citizen information.
              </p>

            </div>

          </div>

          <span class="service-secure-badge">
            🔐 Secure Service Access
          </span>

        </section>

        <div class="service-layout">

          <div>

            <section class="service-card">

              <div class="service-card-header">

                <div class="service-card-icon">
                  🏛️
                </div>

                <div>

                  <h2>
                    Apply for Government Service
                  </h2>

                  <p>
                    Select the service you want to access through BharatSetu.
                  </p>

                </div>

              </div>

              <div class="service-welcome">

                <h3>
                  Welcome, <%= citizen.identity.fullName %> 👋
                </h3>

                <p>
                  Your verified government information can be securely reused for the selected service.
                </p>

              </div>

              <form action="/consent" method="GET">

                <input
                  type="hidden"
                  name="nationalId"
                  value="<%= citizen.nationalId %>"
                >

                <div class="service-form-group">

                  <label for="serviceType">
                    Select Service Category
                  </label>

                  <select
                    id="serviceType"
                    name="serviceType"
                    required
                    onchange="showServiceDetails()"
                  >

                    <option value="">
                      Select a category
                    </option>

                    <option value="Scholarship & Education">
                      🎓 Scholarship & Education Portals
                    </option>

                    <option value="Document & Certificate">
                      📄 Document Issuance & Certificates
                    </option>

                    <option value="Citizen Welfare & Pension">
                      💰 Citizen Welfare & Pension Schemes
                    </option>

                    <option value="Utility & Citizen Services">
                      🏛️ Utility & Citizen Services
                    </option>

                  </select>

                </div>

                <div
                  id="serviceDetails"
                  class="service-details"
                  style="display: none;"
                >

                  <div class="service-form-group">

                    <label for="serviceName">
                      Select Portal / Service
                    </label>

                    <select
                      id="serviceName"
                      name="serviceName"
                      required
                      onchange="updateDepartment()"
                    >
                    </select>

                  </div>

                  <div class="service-form-group">

                    <label for="department">
                      Department
                    </label>

                    <input
                      type="text"
                      id="department"
                      name="department"
                      readonly
                    >

                  </div>

                  <div class="verified-information">

                    <div class="verified-header">

                      <div>

                        <h2>
                          Verified Citizen Information
                        </h2>

                        <p>
                          Information retrieved from verified government records.
                        </p>

                      </div>

                      <span class="verified-badge">
                        ✓ Verified
                      </span>

                    </div>

                    <div class="verified-body">

                      <div class="verified-row">

                        <span class="verified-label">
                          Name
                        </span>

                        <strong class="verified-value">
                          <%= citizen.identity.fullName || "Not Available" %>
                        </strong>

                      </div>

                      <div class="verified-row">

                        <span class="verified-label">
                          Date of Birth
                        </span>

                        <strong class="verified-value">
                          <%= citizen.identity.dob
                            ? new Date(citizen.identity.dob).toLocaleDateString()
                            : "Not Available" %>
                        </strong>

                      </div>

                      <div class="verified-row">

                        <span class="verified-label">
                          Address
                        </span>

                        <strong class="verified-value">
                          <%= citizen.identity.address || "Not Available" %>
                        </strong>

                      </div>

                      <div class="verified-row">

                        <span class="verified-label">
                          Annual Income
                        </span>

                        <strong class="verified-value">
                          ₹<%= citizen.income.annualIncome ?? "Not Available" %>
                        </strong>

                      </div>

                      <div class="verified-row">

                        <span class="verified-label">
                          Education
                        </span>

                        <strong class="verified-value">
                          <%= citizen.education &&
                              citizen.education.length > 0
                              ? citizen.education[0].degree
                              : "Not Available" %>
                        </strong>

                      </div>

                      <div class="verified-row">

                        <span class="verified-label">
                          Caste Category
                        </span>

                        <strong class="verified-value">
                          <%= citizen.caste.category || "Not Available" %>
                        </strong>

                      </div>

                    </div>

                  </div>

                  <div class="consent-preview">

                    <div class="consent-preview-icon">
                      🔐
                    </div>

                    <div>

                      <h3>
                        Consent Manager
                      </h3>

                      <p>
                        You control which verified government data can be accessed by the selected service.
                        Review and provide consent on the next step.
                      </p>

                    </div>

                  </div>

                  <button
                    type="submit"
                    class="service-submit"
                  >
                    Continue to Consent Manager 🔐
                  </button>

                </div>

              </form>

            </section>

            <div class="service-bottom">

              <span class="service-security">
                🔐 Your verified information is securely accessed through the BharatSetu interoperability layer.
              </span>

              <a
                href="/dashboard?nationalId=<%= citizen.nationalId %>"
                class="service-back"
              >
                ← Back to Dashboard
              </a>

            </div>

          </div>

          <aside>

            <section class="service-card side-card">

              <h3>
                Citizen Information
              </h3>

              <div class="side-info-row">

                <span>
                  Citizen Name
                </span>

                <strong>
                  <%= citizen.identity.fullName || "Not Available" %>
                </strong>

              </div>

              <div class="side-info-row">

                <span>
                  National ID
                </span>

                <strong>
                  <%= citizen.nationalId %>
                </strong>

              </div>

              <div class="side-info-row">

                <span>
                  Identity
                </span>

                <strong>
                  ✓ Verified
                </strong>

              </div>

              <div class="side-info-row">

                <span>
                  Government Data
                </span>

                <strong>
                  Connected
                </strong>

              </div>

            </section>

            <section class="service-card side-card">

              <h3>
                How It Works
              </h3>

              <div class="side-info-box">

                <strong>1. Select Service</strong><br>
                Choose the government category and service you need.

                <br><br>

                <strong>2. Review Data</strong><br>
                Check the verified information available for reuse.

                <br><br>

                <strong>3. Give Consent</strong><br>
                Decide which information the selected service can access.

              </div>

            </section>

            <section class="service-card side-card side-consent">

              <h3>
                Data Sharing & Consent
              </h3>

              <span class="side-consent-badge">
                🛡️ Citizen Controlled
              </span>

              <p>
                No government data is shared with the selected service without your consent.
              </p>

              <a
                href="/services?nationalId=<%= citizen.nationalId %>"
                class="side-button"
              >
                Review Services
              </a>

            </section>

          </aside>

        </div>

      </div>

    </main>

  </div>

  <script>

    const services = {

      "Scholarship & Education": [
        {
          name: "MahaDBT / State Scholarship Portal",
          department: "Education Department"
        },
        {
          name: "National Scholarship Portal (NSP)",
          department: "Education Department"
        },
        {
          name: "Foreign Education & Study Grants",
          department: "Education Department"
        }
      ],

      "Document & Certificate": [
        {
          name: "Income & Domicile Services",
          department: "Revenue Department"
        },
        {
          name: "Caste & Community Services",
          department: "Social Welfare Department"
        },
        {
          name: "Civil Registration",
          department: "Revenue Department"
        }
      ],

      "Citizen Welfare & Pension": [
        {
          name: "Farmer Welfare (Krishi Portal)",
          department: "Agriculture Department"
        },
        {
          name: "Social Security & Pensions",
          department: "Social Welfare Department"
        },
        {
          name: "Housing Schemes",
          department: "Housing Department"
        }
      ],

      "Utility & Citizen Services": [
        {
          name: "Voter ID Services (NVSP)",
          department: "Election Department"
        },
        {
          name: "Ration Card & Food Distribution",
          department: "Food & Civil Supplies Department"
        },
        {
          name: "Police & Verification Services",
          department: "Police Department"
        }
      ]

    };

    function showServiceDetails() {

      const serviceType =
        document.getElementById("serviceType").value;

      const serviceName =
        document.getElementById("serviceName");

      const department =
        document.getElementById("department");

      const serviceDetails =
        document.getElementById("serviceDetails");

      serviceName.innerHTML = "";

      department.value = "";

      if (!serviceType) {

        serviceDetails.style.display = "none";

        return;
      }

      serviceDetails.style.display = "block";

      services[serviceType].forEach(service => {

        const option =
          document.createElement("option");

        option.value = service.name;

        option.textContent = service.name;

        serviceName.appendChild(option);

      });

      updateDepartment();

    }

    function updateDepartment() {

      const serviceType =
        document.getElementById("serviceType").value;

      const serviceName =
        document.getElementById("serviceName").value;

      const department =
        document.getElementById("department");

      if (!serviceType || !serviceName) {

        department.value = "";

        return;
      }

      const selectedService =
        services[serviceType].find(
          service => service.name === serviceName
        );

      if (selectedService) {

        department.value =
          selectedService.department;

      }

    }

  </script>

</body>

</html>