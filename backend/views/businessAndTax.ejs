<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Taxation & Business Registry</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    .tax-dashboard {
      min-height: 100vh;
      background: #f3f6fb;
      display: flex;
      color: #172b4d;
    }

    .tax-sidebar {
      width: 230px;
      background: #102f52;
      color: white;
      padding: 20px 14px;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      box-sizing: border-box;
    }

    .tax-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 8px 24px;
    }

    .tax-brand-icon {
      font-size: 30px;
    }

    .tax-brand h2 {
      margin: 0;
      font-size: 20px;
    }

    .tax-brand p {
      margin: 3px 0 0;
      font-size: 11px;
      opacity: 0.75;
    }

    .tax-nav {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .tax-nav a {
      color: white;
      text-decoration: none;
      padding: 11px 12px;
      border-radius: 8px;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 10px;
      opacity: 0.9;
    }

    .tax-nav a:hover,
    .tax-nav a.active {
      background: #1d5d99;
      opacity: 1;
    }

    .tax-sidebar-bottom {
      margin-top: auto;
    }

    .tax-main {
      flex: 1;
      min-width: 0;
    }

    .tax-topbar {
      height: 64px;
      background: white;
      border-bottom: 1px solid #e3e8ef;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      box-sizing: border-box;
    }

    .tax-search {
      width: 420px;
      max-width: 50%;
      background: #f5f7fa;
      border: 1px solid #e3e8ef;
      border-radius: 8px;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 9px;
      color: #7b8798;
      box-sizing: border-box;
    }

    .tax-search input {
      border: none;
      outline: none;
      background: transparent;
      width: 100%;
      font-size: 12px;
    }

    .tax-user {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .tax-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #e8f0fa;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .tax-user strong {
      display: block;
      font-size: 13px;
    }

    .tax-user small {
      color: #7b8798;
      font-size: 11px;
    }

    .tax-content {
      padding: 20px 28px 30px;
    }

    .tax-breadcrumb {
      font-size: 11px;
      color: #7b8798;
      margin-bottom: 16px;
    }

    .tax-breadcrumb span {
      margin: 0 5px;
    }

    .tax-portal-header {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 12px;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 15px;
    }

    .tax-title-area {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .tax-title-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: #e9f3ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 27px;
    }

    .tax-title-area h1 {
      margin: 0 0 5px;
      font-size: 20px;
    }

    .tax-title-area p {
      margin: 0;
      font-size: 12px;
      color: #6c7a8c;
    }

    .tax-verified-box {
      text-align: right;
    }

    .tax-verified-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #e5f7ed;
      color: #16834b;
      padding: 7px 12px;
      border-radius: 18px;
      font-size: 11px;
      font-weight: 600;
    }

    .tax-updated {
      display: block;
      margin-top: 6px;
      font-size: 10px;
      color: #7b8798;
    }

    .tax-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 16px;
    }

    .tax-card {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 12px;
      padding: 18px;
      margin-bottom: 16px;
    }

    .tax-card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 15px;
    }

    .tax-card-title h2 {
      margin: 0;
      font-size: 16px;
    }

    .tax-mini-verified {
      background: #e7f7ed;
      color: #16834b;
      padding: 5px 9px;
      border-radius: 15px;
      font-size: 10px;
      font-weight: 600;
    }

    .tax-data-row {
      display: grid;
      grid-template-columns: 190px 1fr auto;
      align-items: center;
      min-height: 50px;
      border-bottom: 1px solid #edf0f4;
      gap: 12px;
    }

    .tax-data-row:last-child {
      border-bottom: none;
    }

    .tax-data-label {
      color: #68778d;
      font-size: 11px;
    }

    .tax-data-value {
      font-size: 12px;
      font-weight: 600;
      color: #1d2e46;
    }

    .tax-row-status {
      color: #16834b;
      font-size: 10px;
      font-weight: 600;
      background: #effaf3;
      padding: 5px 8px;
      border-radius: 12px;
    }

    .tax-info-box {
      background: #eef6ff;
      border: 1px solid #d7e9fb;
      border-radius: 9px;
      padding: 11px 13px;
      display: flex;
      gap: 9px;
      color: #526b86;
      font-size: 10px;
      line-height: 1.5;
    }

    .tax-info-icon {
      font-size: 15px;
    }

    .tax-side-card h3 {
      margin: 0 0 15px;
      font-size: 14px;
    }

    .tax-department {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 15px;
    }

    .tax-dept-icon {
      width: 42px;
      height: 42px;
      border-radius: 8px;
      background: #f3f5f8;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    .tax-department strong {
      display: block;
      font-size: 12px;
    }

    .tax-department span {
      display: block;
      font-size: 10px;
      color: #718096;
      margin-top: 3px;
    }

    .tax-side-text {
      font-size: 10px;
      color: #64748b;
      line-height: 1.5;
      margin-bottom: 14px;
    }

    .tax-side-button {
      display: block;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      padding: 9px;
      border: 1px solid #b9c8da;
      border-radius: 7px;
      text-decoration: none;
      color: #2365b5;
      font-size: 10px;
      font-weight: 600;
    }

    .tax-consent {
      background: #f1faf5;
      border-color: #d8eddf;
    }

    .tax-consent-badge {
      display: inline-block;
      background: #e1f4e8;
      color: #16834b;
      padding: 5px 9px;
      border-radius: 14px;
      font-size: 10px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .tax-consent p {
      font-size: 10px;
      color: #64748b;
      line-height: 1.5;
      margin: 0 0 13px;
    }

    .tax-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      color: white;
      background: #2365b5;
      padding: 10px 16px;
      border-radius: 7px;
      font-size: 11px;
      font-weight: 600;
    }

    .tax-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 10px;
      padding: 12px 16px;
    }

    .tax-security {
      font-size: 10px;
      color: #68778d;
    }

    @media (max-width: 900px) {
      .tax-sidebar {
        width: 190px;
      }

      .tax-layout {
        grid-template-columns: 1fr;
      }

      .tax-search {
        width: 300px;
      }
    }

    @media (max-width: 650px) {
      .tax-dashboard {
        display: block;
      }

      .tax-sidebar {
        width: 100%;
        min-height: auto;
      }

      .tax-nav {
        flex-direction: row;
        flex-wrap: wrap;
      }

      .tax-sidebar-bottom {
        margin-top: 10px;
      }

      .tax-topbar {
        padding: 0 15px;
      }

      .tax-content {
        padding: 15px;
      }

      .tax-portal-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .tax-verified-box {
        text-align: left;
      }

      .tax-search {
        max-width: 60%;
      }

      .tax-data-row {
        grid-template-columns: 1fr;
        padding: 10px 0;
        gap: 5px;
      }

      .tax-row-status {
        width: fit-content;
      }

      .tax-bottom {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>

  <div class="tax-dashboard">

    <aside class="tax-sidebar">

      <div class="tax-brand">
        <div class="tax-brand-icon">
          🏛️
        </div>

        <div>
          <h2>BharatSetu</h2>
          <p>One Citizen. One Platform.</p>
        </div>
      </div>

      <nav class="tax-nav">

        <a href="/dashboard?nationalId=<%= citizen.nationalId %>">
          🏠
          Home
        </a>

        <a href="/dashboard?nationalId=<%= citizen.nationalId %>#government-portals" class="active">
          🏛️
          Government Portals
        </a>

        <a href="/services?nationalId=<%= citizen.nationalId %>">
          📄
          Services & Applications
        </a>

        <a href="/portal/applicationStatus?nationalId=<%= citizen.nationalId %>">
          🕒
          Application History
        </a>

        <a href="#">
          ☑️
          Eligibility Checker
        </a>

        <a href="#">
          📁
          Document Reuse
        </a>

        <a href="#">
          🛡️
          Consent Management
        </a>

        <a href="#">
          🔍
          Grievance Management
        </a>

        <a href="#">
          🔔
          Notifications
        </a>

      </nav>

      <div class="tax-sidebar-bottom">

        <a href="/login" class="tax-nav">
          <span>🚪 Logout</span>
        </a>

      </div>

    </aside>

    <main class="tax-main">

      <header class="tax-topbar">

        <div class="tax-search">
          🔍
          <input
            type="text"
            placeholder="Search for services, schemes, certificates..."
          >
        </div>

        <div class="tax-user">

          <div class="tax-avatar">
            👤
          </div>

          <div>

            <strong>
              <%= citizen.identity.fullName %>
            </strong>

            <small>
              Citizen
            </small>

          </div>

        </div>

      </header>

      <div class="tax-content">

        <div class="tax-breadcrumb">
          Home
          <span>›</span>
          Government Portals
          <span>›</span>
          Taxation & Business Registry
        </div>

        <section class="tax-portal-header">

          <div class="tax-title-area">

            <div class="tax-title-icon">
              💼
            </div>

            <div>

              <h1>
                Taxation & Business Registry (GST/PAN)
              </h1>

              <p>
                Verified citizen business and taxation information
              </p>

            </div>

          </div>

          <div class="tax-verified-box">

            <span class="tax-verified-badge">
              ✓ Verified Government Data
            </span>

            <span class="tax-updated">
              Securely retrieved from verified records
            </span>

          </div>

        </section>

        <div class="tax-layout">

          <div>

            <section class="tax-card">

              <div class="tax-card-title">

                <h2>
                  Business & Tax Information
                </h2>

                <span class="tax-mini-verified">
                  ✓ Verified
                </span>

              </div>

              <div class="tax-data-row">

                <span class="tax-data-label">
                  PAN Number
                </span>

                <strong class="tax-data-value">
                  <%= citizen.businessAndTax.panNumber || "Not Available" %>
                </strong>

                <span class="tax-row-status">
                  ✓ Verified
                </span>

              </div>

              <div class="tax-data-row">

                <span class="tax-data-label">
                  GSTIN
                </span>

                <strong class="tax-data-value">
                  <%= citizen.businessAndTax.gstin || "Not Available" %>
                </strong>

                <span class="tax-row-status">
                  ✓ Verified
                </span>

              </div>

              <div class="tax-data-row">

                <span class="tax-data-label">
                  Business Name
                </span>

                <strong class="tax-data-value">
                  <%= citizen.businessAndTax.businessName || "Not Available" %>
                </strong>

                <span class="tax-row-status">
                  ✓ Verified
                </span>

              </div>

              <div class="tax-data-row">

                <span class="tax-data-label">
                  Tax Filing Status
                </span>

                <strong class="tax-data-value">
                  <%= citizen.businessAndTax.taxFilingStatus || "Not Available" %>
                </strong>

                <span class="tax-row-status">
                  ✓ Verified
                </span>

              </div>

              <div class="tax-info-box" style="margin-top: 15px;">

                <div class="tax-info-icon">
                  ℹ️
                </div>

                <div>
                  This information has been retrieved from verified government taxation and business records and can be securely reused for eligible government services.
                </div>

              </div>

            </section>

            <section class="tax-card">

              <div class="tax-card-title">

                <h2>
                  Citizen Verification
                </h2>

                <span class="tax-mini-verified">
                  ✓ Verified
                </span>

              </div>

              <div class="tax-data-row">

                <span class="tax-data-label">
                  Citizen Name
                </span>

                <strong class="tax-data-value">
                  <%= citizen.identity.fullName || "Not Available" %>
                </strong>

                <span class="tax-row-status">
                  ✓ Verified
                </span>

              </div>

              <div class="tax-data-row">

                <span class="tax-data-label">
                  National ID
                </span>

                <strong class="tax-data-value">
                  <%= citizen.nationalId || "Not Available" %>
                </strong>

                <span class="tax-row-status">
                  ✓ Verified
                </span>

              </div>

            </section>

            <div class="tax-bottom">

              <span class="tax-security">
                🔐 Your verified information is protected and shared only with your consent.
              </span>

              <a
                href="/dashboard?nationalId=<%= citizen.nationalId %>"
                class="tax-back"
              >
                ← Back to Government Portals
              </a>

            </div>

          </div>

          <aside>

            <section class="tax-card tax-side-card">

              <h3>
                Department Information
              </h3>

              <div class="tax-department">

                <div class="tax-dept-icon">
                  💼
                </div>

                <div>

                  <strong>
                    Taxation & Business Registry
                  </strong>

                  <span>
                    Government of India
                  </span>

                </div>

              </div>

              <p class="tax-side-text">
                This department manages verified business, PAN, GST and taxation information used for eligible government services.
              </p>

              <a href="#" class="tax-side-button">
                🌐 Visit Official Portal ↗
              </a>

            </section>

            <section class="tax-card tax-side-card tax-consent">

              <h3>
                Data Sharing & Consent
              </h3>

              <span class="tax-consent-badge">
                🛡️ Consent Controlled
              </span>

              <p>
                Your business and tax information can be shared with eligible government services only according to your consent.
              </p>

              <a
                href="/services?nationalId=<%= citizen.nationalId %>"
                class="tax-side-button"
              >
                Manage Consent
              </a>

            </section>

            <section class="tax-card tax-side-card">

              <h3>
                Need Help?
              </h3>

              <p class="tax-side-text">
                Need assistance with your business or taxation information?
              </p>

              <a href="#" class="tax-side-button">
                🎧 Raise a Support Request
              </a>

            </section>

          </aside>

        </div>

      </div>

    </main>

  </div>

</body>
</html>