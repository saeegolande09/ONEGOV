<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BharatSetu Dashboard</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    .dashboard-page {
      margin: 0;
      background: #f3f6fb;
      color: #172b4d;
    }

    .dashboard-page .sidebar {
      background: #102f52;
    }

    .dashboard-page .dashboard-main {
      background: #f3f6fb;
    }

    .dashboard-page .topbar {
      background: white;
      border-bottom: 1px solid #e2e8f0;
    }

    .dashboard-content {
      padding: 18px 22px 28px;
    }

    .main-column {
      min-width: 0;
    }

    .hero-section {
      position: relative;
      width: 100%;
      height: 230px;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 18px;
      background: #dcecff;
      border: 1px solid #e1e8f0;
    }

    .hero-section img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .dashboard-section {
      margin-bottom: 20px;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 10px;
    }

    .section-heading h2 {
      margin: 0 0 3px;
      font-size: 18px;
      color: #102a50;
    }

    .section-heading p {
      margin: 0;
      color: #66758a;
      font-size: 11px;
    }

    .section-heading a {
      color: #2365b5;
      text-decoration: none;
      font-size: 11px;
      font-weight: 600;
    }

    .portal-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
    }

    .portal-card {
      position: relative;
      min-height: 130px;
      background: white;
      border: 1px solid #dfe6ee;
      border-radius: 9px;
      padding: 13px;
      text-decoration: none;
      color: #172b4d;
      box-sizing: border-box;
      transition: 0.2s ease;
    }

    .portal-card:hover {
      transform: translateY(-2px);
      border-color: #9bbde1;
      box-shadow: 0 5px 16px rgba(27, 67, 108, 0.08);
    }

    .portal-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      margin-bottom: 9px;
    }

    .portal-icon.blue {
      background: #e6f1ff;
    }

    .portal-icon.green {
      background: #e6f8ef;
    }

    .portal-icon.pink {
      background: #f4eaff;
    }

    .portal-icon.red {
      background: #ffe8ed;
    }

    .portal-icon.orange {
      background: #fff1d8;
    }

    .portal-icon.purple {
      background: #eee9ff;
    }

    .card-arrow {
      position: absolute;
      right: 12px;
      top: 13px;
      color: #718096;
      font-size: 19px;
    }

    .portal-card h3 {
      margin: 0 18px 5px 0;
      font-size: 11px;
      line-height: 1.35;
      color: #172b4d;
    }

    .portal-card p {
      margin: 0 0 8px;
      color: #718096;
      font-size: 9px;
    }

    .verified-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: #e2f7ea;
      color: #16834b;
      border-radius: 12px;
      padding: 4px 7px;
      font-size: 8px;
      font-weight: 600;
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
    }

    .service-card {
      background: white;
      border: 1px solid #dfe6ee;
      border-radius: 9px;
      padding: 14px;
      min-height: 115px;
      box-sizing: border-box;
      text-decoration: none;
      color: #172b4d;
      transition: 0.2s ease;
    }

    .service-card:hover {
      transform: translateY(-2px);
      border-color: #9bbde1;
      box-shadow: 0 5px 16px rgba(27, 67, 108, 0.08);
    }

    .service-icon {
      width: 35px;
      height: 35px;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      margin-bottom: 9px;
    }

    .service-icon.cyan {
      background: #e3f8fb;
    }

    .service-icon.green {
      background: #e6f8ef;
    }

    .service-icon.orange {
      background: #fff1d8;
    }

    .service-icon.blue {
      background: #e6f1ff;
    }

    .service-icon.red {
      background: #ffe8ed;
    }

    .service-icon.purple {
      background: #eee9ff;
    }

    .service-card h3 {
      margin: 0 0 5px;
      font-size: 11px;
      line-height: 1.3;
    }

    .service-card p {
      margin: 0;
      color: #718096;
      font-size: 9px;
      line-height: 1.4;
    }

    .right-panel {
      min-width: 0;
    }

    .profile-card,
    .notification-card {
      background: white;
      border: 1px solid #dfe6ee;
      border-radius: 10px;
      margin-bottom: 14px;
      padding: 15px;
    }

    .profile-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding-bottom: 13px;
      border-bottom: 1px solid #edf0f4;
    }

    .large-avatar {
      width: 45px;
      height: 45px;
      border-radius: 50%;
      background: #e8f1ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 23px;
      flex-shrink: 0;
    }

    .profile-header h3 {
      margin: 0 0 3px;
      font-size: 13px;
    }

    .profile-header p {
      margin: 0 0 5px;
      color: #718096;
      font-size: 9px;
    }

    .verified {
      color: #16834b;
      font-size: 9px;
      font-weight: 600;
    }

    .profile-details {
      padding-top: 7px;
    }

    .profile-details > div {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      padding: 7px 0;
    }

    .profile-details span {
      color: #718096;
      font-size: 9px;
    }

    .profile-details strong {
      color: #26384f;
      font-size: 9px;
      text-align: right;
      word-break: break-word;
    }

    .profile-button {
      display: block;
      text-align: center;
      margin-top: 8px;
      padding: 8px;
      background: #f1f6fd;
      border: 1px solid #dce7f4;
      border-radius: 7px;
      color: #2365b5;
      text-decoration: none;
      font-size: 9px;
      font-weight: 600;
    }

    .notification-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 7px;
    }

    .notification-heading h3 {
      margin: 0;
      font-size: 13px;
    }

    .notification-heading a {
      color: #2365b5;
      text-decoration: none;
      font-size: 9px;
    }

    .notification-item {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      padding: 10px 0;
      border-bottom: 1px solid #edf0f4;
    }

    .notification-item:last-child {
      border-bottom: none;
    }

    .notification-badge {
      width: 31px;
      height: 31px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 14px;
    }

    .purple-bg {
      background: #f0eaff;
    }

    .green-bg {
      background: #e5f8ed;
    }

    .orange-bg {
      background: #fff1d9;
    }

    .red-bg {
      background: #ffe9ed;
    }

    .notification-item strong {
      display: block;
      font-size: 9px;
      line-height: 1.4;
    }

    .notification-item small {
      display: block;
      margin-top: 3px;
      color: #8a96a6;
      font-size: 8px;
    }

    .india-banner {
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid #dfe6ee;
      background: white;
    }

    .india-banner img {
      width: 100%;
      height: auto;
      display: block;
    }

    .dashboard-bottom-banner {
      margin-top: 5px;
      background: #edf9f2;
      border: 1px solid #cdebd9;
      border-radius: 10px;
      padding: 13px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .dashboard-bottom-banner h3 {
      margin: 0 0 4px;
      font-size: 13px;
    }

    .dashboard-bottom-banner p {
      margin: 0;
      color: #64748b;
      font-size: 9px;
    }

    .dashboard-bottom-banner span {
      font-size: 10px;
      font-weight: 600;
      color: #16834b;
      white-space: nowrap;
    }

    @media (max-width: 1200px) {
      .portal-grid,
      .service-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    @media (max-width: 1000px) {
      .dashboard-content {
        padding: 15px;
      }

      .dashboard-page .dashboard-content {
        grid-template-columns: 1fr;
      }

      .portal-grid,
      .service-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .hero-section {
        height: 210px;
      }
    }

    @media (max-width: 700px) {
      .portal-grid,
      .service-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .hero-section {
        height: 170px;
      }
    }

    @media (max-width: 500px) {
      .portal-grid,
      .service-grid {
        grid-template-columns: 1fr;
      }

      .hero-section {
        height: 150px;
      }

      .dashboard-bottom-banner {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</head>

<body class="dashboard-page">

  <aside class="sidebar">

    <div class="brand">
      <div class="brand-emblem">🏛️</div>

      <div>
        <h2>BharatSetu</h2>
        <p>One Citizen. One Platform.</p>
      </div>
    </div>

    <nav class="sidebar-nav">

      <a
        href="/dashboard?nationalId=<%= citizen.nationalId %>"
        class="nav-item active"
      >
        🏠
        <span>Home</span>
      </a>

      <a
        href="#government-portals"
        class="nav-item"
      >
        🏛️
        <span>Government Portals</span>
      </a>

      <a
        href="/services?nationalId=<%= citizen.nationalId %>"
        class="nav-item"
      >
        💼
        <span>Services & Applications</span>
      </a>

      <a
        href="/portal/applicationStatus?nationalId=<%= citizen.nationalId %>"
        class="nav-item"
      >
        🕒
        <span>Application History</span>
      </a>

      <a href="#" class="nav-item">
        ☑️
        <span>Eligibility Checker</span>
      </a>

      <a href="#" class="nav-item">
        📄
        <span>Document Reuse</span>
      </a>

      <a href="#" class="nav-item">
        🛡️
        <span>Consent Management</span>
      </a>

      <a href="#" class="nav-item">
        🔍
        <span>Grievance Management</span>
      </a>

      <a href="#" class="nav-item">
        🔔
        <span>Notifications</span>
      </a>

      <a href="#" class="nav-item">
        🔎
        <span>Service Search</span>
      </a>

      <a href="#" class="nav-item">
        📋
        <span>Audit Logs</span>
      </a>

      <a href="#" class="nav-item">
        ❓
        <span>Help & FAQ</span>
      </a>

      <a href="#" class="nav-item">
        👥
        <span>Role-Based Access</span>
      </a>

    </nav>

    <div class="sidebar-bottom">

      <a href="/login" class="nav-item">
        🚪
        <span>Logout</span>
      </a>

    </div>

  </aside>

  <main class="dashboard-main">

    <header class="topbar">

      <div class="search-box">
        🔍

        <input
          type="text"
          placeholder="Search for services, schemes, certificates..."
        >
      </div>

      <div class="topbar-right">

        <div class="notification-icon">
          🔔
          <span>3</span>
        </div>

        <div class="profile-mini">

          <div class="profile-avatar">
            👤
          </div>

          <div>

            <strong>
              <%= citizen.identity.fullName || "Citizen" %>
            </strong>

            <small>
              Citizen
            </small>

          </div>

          <span>⌄</span>

        </div>

      </div>

    </header>

    <section class="dashboard-content">

      <div class="main-column">

        <section class="hero-section">

          <img
            src="/image/india-gate-banner.png"
            alt="BharatSetu Digital India"
          >

        </section>

        <section
          class="dashboard-section"
          id="government-portals"
        >

          <div class="section-heading">

            <div>

              <h2>
                Government Portals
              </h2>

              <p>
                Access your verified data from various government departments
              </p>

            </div>

            <a href="#government-portals">
              View All →
            </a>

          </div>

          <div class="portal-grid">

            <a
              href="/portal/identity?nationalId=<%= citizen.nationalId %>"
              class="portal-card"
            >

              <div class="portal-icon blue">
                🪪
              </div>

              <div class="card-arrow">
                ›
              </div>

              <h3>
                1. National Identity & Address Portal
              </h3>

              <p>
                UIDAI
              </p>

              <span class="verified-tag">
                ✓ Verified
              </span>

            </a>

            <a
              href="/portal/income?nationalId=<%= citizen.nationalId %>"
              class="portal-card"
            >

              <div class="portal-icon green">
                📊
              </div>

              <div class="card-arrow">
                ›
              </div>

              <h3>
                2. Revenue & Income Assessment Portal
              </h3>

              <p>
                Income Tax Department
              </p>

              <span class="verified-tag">
                ✓ Verified
              </span>

            </a>

            <a
              href="/portal/education?nationalId=<%= citizen.nationalId %>"
              class="portal-card"
            >

              <div class="portal-icon pink">
                🎓
              </div>

              <div class="card-arrow">
                ›
              </div>

              <h3>
                3. Educational Qualifications Registry
              </h3>

              <p>
                Education Department
              </p>

              <span class="verified-tag">
                ✓ Verified
              </span>

            </a>

            <a
              href="/portal/health?nationalId=<%= citizen.nationalId %>"
              class="portal-card"
            >

              <div class="portal-icon red">
                ❤️
              </div>

              <div class="card-arrow">
                ›
              </div>

              <h3>
                4. National Health Authority (ABHA)
              </h3>

              <p>
                Ministry of Health
              </p>

              <span class="verified-tag">
                ✓ Verified
              </span>

            </a>

            <a
              href="/portal/caste?nationalId=<%= citizen.nationalId %>"
              class="portal-card"
            >

              <div class="portal-icon orange">
                👥
              </div>

              <div class="card-arrow">
                ›
              </div>

              <h3>
                5. Social Welfare & Caste Certificate
              </h3>

              <p>
                Social Justice Dept.
              </p>

              <span class="verified-tag">
                ✓ Verified
              </span>

            </a>

            <a
              href="/portal/drivingLicense?nationalId=<%= citizen.nationalId %>"
              class="portal-card"
            >

              <div class="portal-icon blue">
                🚗
              </div>

              <div class="card-arrow">
                ›
              </div>

              <h3>
                6. Transport Department (RTO)
              </h3>

              <p>
                Ministry of Road Transport
              </p>

              <span class="verified-tag">
                ✓ Verified
              </span>

            </a>

            <a
              href="/portal/land?nationalId=<%= citizen.nationalId %>"
              class="portal-card"
            >

              <div class="portal-icon green">
                📍
              </div>

              <div class="card-arrow">
                ›
              </div>

              <h3>
                7. Land Records & Revenue Department
              </h3>

              <p>
                State Revenue Dept.
              </p>

              <span class="verified-tag">
                ✓ Verified
              </span>

            </a>

            <a
              href="/portal/businessAndTax?nationalId=<%= citizen.nationalId %>"
              class="portal-card"
            >

              <div class="portal-icon purple">
                📄
              </div>

              <div class="card-arrow">
                ›
              </div>

              <h3>
                8. Taxation & Business Registry (GST/PAN)
              </h3>

              <p>
                Ministry of Finance
              </p>

              <span class="verified-tag">
                ✓ Verified
              </span>

            </a>

            <a
              href="/portal/employment?nationalId=<%= citizen.nationalId %>"
              class="portal-card"
            >

              <div class="portal-icon blue">
                💼
              </div>

              <div class="card-arrow">
                ›
              </div>

              <h3>
                9. Employment Exchange Board
              </h3>

              <p>
                Labour & Employment
              </p>

              <span class="verified-tag">
                ✓ Verified
              </span>

            </a>

            <a
              href="/portal/applicationStatus?nationalId=<%= citizen.nationalId %>"
              class="portal-card"
            >

              <div class="portal-icon orange">
                📋
              </div>

              <div class="card-arrow">
                ›
              </div>

              <h3>
                10. Unified Scheme & Application Tracker
              </h3>

              <p>
                Government of India
              </p>

              <span class="verified-tag">
                ✓ Verified
              </span>

            </a>

          </div>

        </section>

        <section class="dashboard-section">

          <div class="section-heading">

            <div>

              <h2>
                Key Services & Applications
              </h2>

              <p>
                Apply, Track, Manage and Stay Informed
              </p>

            </div>

            <a href="/services?nationalId=<%= citizen.nationalId %>">
              View All →
            </a>

          </div>

          <div class="service-grid">

            <a
              href="/services?nationalId=<%= citizen.nationalId %>"
              class="service-card"
            >

              <div class="service-icon cyan">
                📄
              </div>

              <h3>
                Apply for Schemes & Scholarships
              </h3>

              <p>
                Apply for schemes, scholarships and certificates
              </p>

            </a>

            <a href="#" class="service-card">

              <div class="service-icon green">
                🛡️
              </div>

              <h3>
                Consent Management
              </h3>

              <p>
                Control your data sharing
              </p>

            </a>

            <a href="#" class="service-card">

              <div class="service-icon orange">
                📁
              </div>

              <h3>
                Document Reuse
              </h3>

              <p>
                Use verified documents across services
              </p>

            </a>

            <a
              href="/dashboard?nationalId=<%= citizen.nationalId %>"
              class="service-card"
            >

              <div class="service-icon blue">
                ▦
              </div>

              <h3>
                Citizen Dashboard
              </h3>

              <p>
                All your data and activities in one place
              </p>

            </a>

            <a href="#" class="service-card">

              <div class="service-icon red">
                🔔
              </div>

              <h3>
                Notifications
              </h3>

              <p>
                Stay updated with real-time alerts
              </p>

            </a>

            <a href="#" class="service-card">

              <div class="service-icon blue">
                🔍
              </div>

              <h3>
                Eligibility Checker
              </h3>

              <p>
                Find schemes you are eligible for
              </p>

            </a>

            <a
              href="/portal/applicationStatus?nationalId=<%= citizen.nationalId %>"
              class="service-card"
            >

              <div class="service-icon purple">
                🕒
              </div>

              <h3>
                Application History
              </h3>

              <p>
                View past applications and results
              </p>

            </a>

            <a href="#" class="service-card">

              <div class="service-icon green">
                💬
              </div>

              <h3>
                Grievance Management
              </h3>

              <p>
                Raise and track your complaints
              </p>

            </a>

            <a href="#" class="service-card">

              <div class="service-icon purple">
                🔗
              </div>

              <h3>
                Secure Data Sharing
              </h3>

              <p>
                Enable secure department data access
              </p>

            </a>

            <a href="#" class="service-card">

              <div class="service-icon cyan">
                📋
              </div>

              <h3>
                Audit Logs
              </h3>

              <p>
                Track who accessed your data
              </p>

            </a>

          </div>

        </section>

        <div class="dashboard-bottom-banner">

          <div>

            <h3>
              🌱 A Greener, Paperless, Citizen-Centric Bharat
            </h3>

            <p>
              Reuse verified data. Avoid repeated documentation. Save time and resources.
            </p>

          </div>

          <span>
            Less Paper • More Progress
          </span>

        </div>

      </div>

      <aside class="right-panel">

        <div class="profile-card">

          <div class="profile-header">

            <div class="large-avatar">
              👤
            </div>

            <div>

              <h3>
                <%= citizen.identity.fullName || "Citizen" %>
              </h3>

              <p>
                National ID: <%= citizen.nationalId %>
              </p>

              <span class="verified">
                ● Verified Citizen
              </span>

            </div>

          </div>

          <div class="profile-details">

            <div>

              <span>
                Date of Birth
              </span>

              <strong>
                <%= citizen.identity.dob
                  ? new Date(citizen.identity.dob).toLocaleDateString()
                  : "Not Available" %>
              </strong>

            </div>

            <div>

              <span>
                Gender
              </span>

              <strong>
                <%= citizen.identity.gender || "Not Available" %>
              </strong>

            </div>

            <div>

              <span>
                State
              </span>

              <strong>
                <%= citizen.identity.address
                  ? citizen.identity.address.split(",").pop().trim()
                  : "Not Available" %>
              </strong>

            </div>

            <div>

              <span>
                Father Name
              </span>

              <strong>
