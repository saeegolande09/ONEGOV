<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Land Records & Revenue Department</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    .land-dashboard {
      min-height: 100vh;
      background: #f3f6fb;
      display: flex;
      color: #172b4d;
    }

    .land-sidebar {
      width: 230px;
      background: #102f52;
      color: white;
      padding: 20px 14px;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      box-sizing: border-box;
    }

    .land-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 8px 24px;
    }

    .land-brand-icon {
      font-size: 30px;
    }

    .land-brand h2 {
      margin: 0;
      font-size: 20px;
    }

    .land-brand p {
      margin: 3px 0 0;
      font-size: 11px;
      opacity: 0.75;
    }

    .land-nav {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .land-nav a {
      color: white;
      text-decoration: none;
      padding: 11px 12px;
      border-radius: 8px;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 10px;
      opacity: 0.9;
    }

    .land-nav a:hover,
    .land-nav a.active {
      background: #1d5d99;
      opacity: 1;
    }

    .land-sidebar-bottom {
      margin-top: auto;
    }

    .land-main {
      flex: 1;
      min-width: 0;
    }

    .land-topbar {
      height: 64px;
      background: white;
      border-bottom: 1px solid #e3e8ef;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      box-sizing: border-box;
    }

    .land-search {
      width: 420px;
      max-width: 50%;
      background: #f5f7fa;
      border: 1px solid #e3e8ef;
      border-radius: 8px;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 9px;
      color: #7b8798;
      box-sizing: border-box;
    }

    .land-search input {
      border: none;
      outline: none;
      background: transparent;
      width: 100%;
      font-size: 12px;
    }

    .land-user {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .land-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #e8f0fa;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .land-user strong {
      display: block;
      font-size: 13px;
    }

    .land-user small {
      color: #7b8798;
      font-size: 11px;
    }

    .land-content {
      padding: 20px 28px 30px;
    }

    .land-breadcrumb {
      font-size: 11px;
      color: #7b8798;
      margin-bottom: 16px;
    }

    .land-breadcrumb span {
      margin: 0 5px;
    }

    .land-portal-header {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 12px;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 15px;
    }

    .land-title-area {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .land-title-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: #e9f3ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 27px;
    }

    .land-title-area h1 {
      margin: 0 0 5px;
      font-size: 20px;
    }

    .land-title-area p {
      margin: 0;
      font-size: 12px;
      color: #6c7a8c;
    }

    .land-verified-box {
      text-align: right;
    }

    .land-verified-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #e5f7ed;
      color: #16834b;
      padding: 7px 12px;
      border-radius: 18px;
      font-size: 11px;
      font-weight: 600;
    }

    .land-updated {
      display: block;
      margin-top: 6px;
      font-size: 10px;
      color: #7b8798;
    }

    .land-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 16px;
    }

    .land-card {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 12px;
      padding: 18px;
      margin-bottom: 16px;
    }

    .land-card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 15px;
    }

    .land-card-title h2 {
      margin: 0;
      font-size: 16px;
    }

    .land-mini-verified {
      background: #e7f7ed;
      color: #16834b;
      padding: 5px 9px;
      border-radius: 15px;
      font-size: 10px;
      font-weight: 600;
    }

    .land-record {
      border: 1px solid #edf0f4;
      border-radius: 10px;
      padding: 0 14px;
      margin-bottom: 14px;
    }

    .land-record:last-child {
      margin-bottom: 0;
    }

    .land-data-row {
      display: grid;
      grid-template-columns: 190px 1fr auto;
      align-items: center;
      min-height: 50px;
      border-bottom: 1px solid #edf0f4;
      gap: 12px;
    }

    .land-data-row:last-child {
      border-bottom: none;
    }

    .land-data-label {
      color: #68778d;
      font-size: 11px;
    }

    .land-data-value {
      font-size: 12px;
      font-weight: 600;
      color: #1d2e46;
    }

    .land-row-status {
      color: #16834b;
      font-size: 10px;
      font-weight: 600;
      background: #effaf3;
      padding: 5px 8px;
      border-radius: 12px;
    }

    .land-info-box {
      background: #eef6ff;
      border: 1px solid #d7e9fb;
      border-radius: 9px;
      padding: 11px 13px;
      display: flex;
      gap: 9px;
      color: #526b86;
      font-size: 10px;
      line-height: 1.5;
    }

    .land-info-icon {
      font-size: 15px;
    }

    .land-side-card h3 {
      margin: 0 0 15px;
      font-size: 14px;
    }

    .land-department {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 15px;
    }

    .land-dept-icon {
      width: 42px;
      height: 42px;
      border-radius: 8px;
      background: #f3f5f8;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    .land-department strong {
      display: block;
      font-size: 12px;
    }

    .land-department span {
      display: block;
      font-size: 10px;
      color: #718096;
      margin-top: 3px;
    }

    .land-side-text {
      font-size: 10px;
      color: #64748b;
      line-height: 1.5;
      margin-bottom: 14px;
    }

    .land-side-button {
      display: block;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      padding: 9px;
      border: 1px solid #b9c8da;
      border-radius: 7px;
      text-decoration: none;
      color: #2365b5;
      font-size: 10px;
      font-weight: 600;
    }

    .land-consent {
      background: #f1faf5;
      border-color: #d8eddf;
    }

    .land-consent-badge {
      display: inline-block;
      background: #e1f4e8;
      color: #16834b;
      padding: 5px 9px;
      border-radius: 14px;
      font-size: 10px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .land-consent p {
      font-size: 10px;
      color: #64748b;
      line-height: 1.5;
      margin: 0 0 13px;
    }

    .land-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      color: white;
      background: #2365b5;
      padding: 10px 16px;
      border-radius: 7px;
      font-size: 11px;
      font-weight: 600;
    }

    .land-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 10px;
      padding: 12px 16px;
    }

    .land-security {
      font-size: 10px;
      color: #68778d;
    }

    .land-empty {
      padding: 25px;
      text-align: center;
      color: #718096;
      font-size: 12px;
      background: #f8fafc;
      border-radius: 8px;
    }

    @media (max-width: 900px) {
      .land-sidebar {
        width: 190px;
      }

      .land-layout {
        grid-template-columns: 1fr;
      }

      .land-search {
        width: 300px;
      }
    }

    @media (max-width: 650px) {
      .land-dashboard {
        display: block;
      }

      .land-sidebar {
        width: 100%;
        min-height: auto;
      }

      .land-nav {
        flex-direction: row;
        flex-wrap: wrap;
      }

      .land-sidebar-bottom {
        margin-top: 10px;
      }

      .land-topbar {
        padding: 0 15px;
      }

      .land-content {
        padding: 15px;
      }

      .land-portal-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .land-verified-box {
        text-align: left;
      }

      .land-search {
        max-width: 60%;
      }

      .land-data-row {
        grid-template-columns: 1fr;
        padding: 10px 0;
        gap: 5px;
      }

      .land-row-status {
        width: fit-content;
      }

      .land-record {
        padding: 0 10px;
      }

      .land-bottom {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>

  <div class="land-dashboard">

    <aside class="land-sidebar">

      <div class="land-brand">
        <div class="land-brand-icon">
          🏛️
        </div>

        <div>
          <h2>BharatSetu</h2>
          <p>One Citizen. One Platform.</p>
        </div>
      </div>

      <nav class="land-nav">

        <a href="/dashboard?nationalId=<%= citizen.nationalId %>">
          🏠
          Home
        </a>

        <a href="/dashboard?nationalId=<%= citizen.nationalId %>#government-portals" class="active">
          🏛️
          Government Portals
        </a>

        <a href="/services?nationalId=<%= citizen.nationalId %>">
          📄
          Services & Applications
        </a>

        <a href="/portal/applicationStatus?nationalId=<%= citizen.nationalId %>">
          🕒
          Application History
        </a>

        <a href="#">
          ☑️
          Eligibility Checker
        </a>

        <a href="#">
          📁
          Document Reuse
        </a>

        <a href="#">
          🛡️
          Consent Management
        </a>

        <a href="#">
          🔍
          Grievance Management
        </a>

        <a href="#">
          🔔
          Notifications
        </a>

      </nav>

      <div class="land-sidebar-bottom">

        <a href="/login" class="land-nav">
          <span>🚪 Logout</span>
        </a>

      </div>

    </aside>

    <main class="land-main">

      <header class="land-topbar">

        <div class="land-search">
          🔍
          <input
            type="text"
            placeholder="Search for services, schemes, certificates..."
          >
        </div>

        <div class="land-user">

          <div class="land-avatar">
            👤
          </div>

          <div>

            <strong>
              <%= citizen.identity.fullName %>
            </strong>

            <small>
              Citizen
            </small>

          </div>

        </div>

      </header>

      <div class="land-content">

        <div class="land-breadcrumb">
          Home
          <span>›</span>
          Government Portals
          <span>›</span>
          Land Records & Revenue Department
        </div>

        <section class="land-portal-header">

          <div class="land-title-area">

            <div class="land-title-icon">
              🌾
            </div>

            <div>

              <h1>
                Land Records & Revenue Department
              </h1>

              <p>
                Verified citizen land ownership records
              </p>

            </div>

          </div>

          <div class="land-verified-box">

            <span class="land-verified-badge">
              ✓ Verified Government Data
            </span>

            <span class="land-updated">
              Securely retrieved from verified records
            </span>

          </div>

        </section>

        <div class="land-layout">

          <div>

            <section class="land-card">

              <div class="land-card-title">

                <h2>
                  Land Information
                </h2>

                <span class="land-mini-verified">
                  ✓ Verified
                </span>

              </div>

              <% if (citizen.land && citizen.land.length > 0) { %>

                <% citizen.land.forEach(land => { %>

                  <div class="land-record">

                    <div class="land-data-row">

                      <span class="land-data-label">
                        Survey Number
                      </span>

                      <strong class="land-data-value">
                        <%= land.surveyNumber || "Not Available" %>
                      </strong>

                      <span class="land-row-status">
                        ✓ Verified
                      </span>

                    </div>

                    <div class="land-data-row">

                      <span class="land-data-label">
                        Area
                      </span>

                      <strong class="land-data-value">
                        <%= land.areaInAcres ?? "Not Available" %> Acres
                      </strong>

                      <span class="land-row-status">
                        ✓ Verified
                      </span>

                    </div>

                    <div class="land-data-row">

                      <span class="land-data-label">
                        District
                      </span>

                      <strong class="land-data-value">
                        <%= land.district || "Not Available" %>
                      </strong>

                      <span class="land-row-status">
                        ✓ Verified
                      </span>

                    </div>

                    <div class="land-data-row">

                      <span class="land-data-label">
                        State
                      </span>

                      <strong class="land-data-value">
                        <%= land.state || "Not Available" %>
                      </strong>

                      <span class="land-row-status">
                        ✓ Verified
                      </span>

                    </div>

                  </div>

                <% }) %>

              <% } else { %>

                <div class="land-empty">
                  No land records available.
                </div>

              <% } %>

              <div class="land-info-box" style="margin-top: 15px;">

                <div class="land-info-icon">
                  ℹ️
                </div>

                <div>
                  This information has been retrieved from verified government land records and can be securely reused for eligible government services.
                </div>

              </div>

            </section>

            <section class="land-card">

              <div class="land-card-title">

                <h2>
                  Citizen Verification
                </h2>

                <span class="land-mini-verified">
                  ✓ Verified
                </span>

              </div>

              <div class="land-data-row">

                <span class="land-data-label">
                  Citizen Name
                </span>

                <strong class="land-data-value">
                  <%= citizen.identity.fullName || "Not Available" %>
                </strong>

                <span class="land-row-status">
                  ✓ Verified
                </span>

              </div>

              <div class="land-data-row">

                <span class="land-data-label">
                  National ID
                </span>

                <strong class="land-data-value">
                  <%= citizen.nationalId || "Not Available" %>
                </strong>

                <span class="land-row-status">
                  ✓ Verified
                </span>

              </div>

            </section>

            <div class="land-bottom">

              <span class="land-security">
                🔐 Your verified information is protected and shared only with your consent.
              </span>

              <a
                href="/dashboard?nationalId=<%= citizen.nationalId %>"
                class="land-back"
              >
                ← Back to Government Portals
              </a>

            </div>

          </div>

          <aside>

            <section class="land-card land-side-card">

              <h3>
                Department Information
              </h3>

              <div class="land-department">

                <div class="land-dept-icon">
                  🏛️
                </div>

                <div>

                  <strong>
                    Land Records & Revenue Department
                  </strong>

                  <span>
                    Government of India
                  </span>

                </div>

              </div>

              <p class="land-side-text">
                This department manages verified land ownership and property records used for eligible government services and schemes.
              </p>

              <a href="#" class="land-side-button">
                🌐 Visit Official Portal ↗
              </a>

            </section>

            <section class="land-card land-side-card land-consent">

              <h3>
                Data Sharing & Consent
              </h3>

              <span class="land-consent-badge">
                🛡️ Consent Controlled
              </span>

              <p>
                Your land information can be shared with eligible government services only according to your consent.
              </p>

              <a
                href="/services?nationalId=<%= citizen.nationalId %>"
                class="land-side-button"
              >
                Manage Consent
              </a>

            </section>

            <section class="land-card land-side-card">

              <h3>
                Need Help?
              </h3>

              <p class="land-side-text">
                Need assistance with your land records or government services?
              </p>

              <a href="#" class="land-side-button">
                🎧 Raise a Support Request
              </a>

            </section>

          </aside>

        </div>

      </div>

    </main>

  </div>

</body>
</html>