<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>National Identity & Address Portal</title>

  <link rel="stylesheet" href="/style.css">

  <style>
    .identity-dashboard {
      min-height: 100vh;
      background: #f3f6fb;
      display: flex;
      color: #172b4d;
    }

    .identity-sidebar {
      width: 230px;
      background: #102f52;
      color: white;
      padding: 20px 14px;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      box-sizing: border-box;
    }

    .identity-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 8px 24px;
    }

    .identity-brand-icon {
      font-size: 30px;
    }

    .identity-brand h2 {
      margin: 0;
      font-size: 20px;
    }

    .identity-brand p {
      margin: 3px 0 0;
      font-size: 11px;
      opacity: 0.75;
    }

    .identity-nav {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .identity-nav a {
      color: white;
      text-decoration: none;
      padding: 11px 12px;
      border-radius: 8px;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 10px;
      opacity: 0.9;
    }

    .identity-nav a:hover,
    .identity-nav a.active {
      background: #1d5d99;
      opacity: 1;
    }

    .identity-sidebar-bottom {
      margin-top: auto;
    }

    .identity-main {
      flex: 1;
      min-width: 0;
    }

    .identity-topbar {
      height: 64px;
      background: white;
      border-bottom: 1px solid #e3e8ef;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      box-sizing: border-box;
    }

    .identity-search {
      width: 420px;
      max-width: 50%;
      background: #f5f7fa;
      border: 1px solid #e3e8ef;
      border-radius: 8px;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 9px;
      color: #7b8798;
      box-sizing: border-box;
    }

    .identity-search input {
      border: none;
      outline: none;
      background: transparent;
      width: 100%;
      font-size: 12px;
    }

    .identity-user {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .identity-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #e8f0fa;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .identity-user strong {
      display: block;
      font-size: 13px;
    }

    .identity-user small {
      color: #7b8798;
      font-size: 11px;
    }

    .identity-content {
      padding: 20px 28px 30px;
    }

    .identity-breadcrumb {
      font-size: 11px;
      color: #7b8798;
      margin-bottom: 16px;
    }

    .identity-breadcrumb span {
      margin: 0 5px;
    }

    .identity-portal-header {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 12px;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 14px;
    }

    .identity-title-area {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .identity-title-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: #e9f3ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 27px;
    }

    .identity-title-area h1 {
      margin: 0 0 5px;
      font-size: 20px;
    }

    .identity-title-area p {
      margin: 0;
      font-size: 12px;
      color: #6c7a8c;
    }

    .identity-verified-box {
      text-align: right;
    }

    .identity-verified-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #e5f7ed;
      color: #16834b;
      padding: 7px 12px;
      border-radius: 18px;
      font-size: 11px;
      font-weight: 600;
    }

    .identity-updated {
      display: block;
      margin-top: 6px;
      font-size: 10px;
      color: #7b8798;
    }

    .identity-tabs {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 10px;
      padding: 0 18px;
      display: flex;
      gap: 25px;
      margin-bottom: 15px;
    }

    .identity-tabs a {
      padding: 13px 2px;
      text-decoration: none;
      color: #66758a;
      font-size: 12px;
      border-bottom: 2px solid transparent;
    }

    .identity-tabs a.active {
      color: #2365b5;
      border-bottom-color: #2365b5;
      font-weight: 600;
    }

    .identity-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 16px;
    }

    .identity-card {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 12px;
      padding: 18px;
      margin-bottom: 16px;
    }

    .identity-card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 15px;
    }

    .identity-card-title h2 {
      margin: 0;
      font-size: 16px;
    }

    .identity-mini-verified {
      background: #e7f7ed;
      color: #16834b;
      padding: 5px 9px;
      border-radius: 15px;
      font-size: 10px;
      font-weight: 600;
    }

    .identity-data-row {
      display: grid;
      grid-template-columns: 190px 1fr auto;
      align-items: center;
      min-height: 50px;
      border-bottom: 1px solid #edf0f4;
      gap: 12px;
    }

    .identity-data-row:last-child {
      border-bottom: none;
    }

    .identity-data-label {
      color: #68778d;
      font-size: 11px;
    }

    .identity-data-value {
      font-size: 12px;
      font-weight: 600;
      color: #1d2e46;
    }

    .identity-row-status {
      color: #16834b;
      font-size: 10px;
      font-weight: 600;
      background: #effaf3;
      padding: 5px 8px;
      border-radius: 12px;
    }

    .identity-info-box {
      background: #eef6ff;
      border: 1px solid #d7e9fb;
      border-radius: 9px;
      padding: 11px 13px;
      display: flex;
      gap: 9px;
      color: #526b86;
      font-size: 10px;
      line-height: 1.5;
    }

    .identity-info-icon {
      font-size: 15px;
    }

    .identity-side-card h3 {
      margin: 0 0 15px;
      font-size: 14px;
    }

    .identity-department {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 15px;
    }

    .identity-dept-icon {
      width: 42px;
      height: 42px;
      border-radius: 8px;
      background: #f3f5f8;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    .identity-department strong {
      display: block;
      font-size: 12px;
    }

    .identity-department span {
      display: block;
      font-size: 10px;
      color: #718096;
      margin-top: 3px;
    }

    .identity-side-text {
      font-size: 10px;
      color: #64748b;
      line-height: 1.5;
      margin-bottom: 14px;
    }

    .identity-side-button {
      display: block;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      padding: 9px;
      border: 1px solid #b9c8da;
      border-radius: 7px;
      text-decoration: none;
      color: #2365b5;
      font-size: 10px;
      font-weight: 600;
    }

    .identity-consent {
      background: #f1faf5;
      border-color: #d8eddf;
    }

    .identity-consent-badge {
      display: inline-block;
      background: #e1f4e8;
      color: #16834b;
      padding: 5px 9px;
      border-radius: 14px;
      font-size: 10px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .identity-consent p {
      font-size: 10px;
      color: #64748b;
      line-height: 1.5;
      margin: 0 0 13px;
    }

    .identity-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      color: white;
      background: #2365b5;
      padding: 10px 16px;
      border-radius: 7px;
      font-size: 11px;
      font-weight: 600;
    }

    .identity-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 10px;
      padding: 12px 16px;
    }

    .identity-security {
      font-size: 10px;
      color: #68778d;
    }

    @media (max-width: 900px) {
      .identity-sidebar {
        width: 190px;
      }

      .identity-layout {
        grid-template-columns: 1fr;
      }

      .identity-search {
        width: 300px;
      }
    }

    @media (max-width: 650px) {
      .identity-dashboard {
        display: block;
      }

      .identity-sidebar {
        width: 100%;
        min-height: auto;
      }

      .identity-nav {
        flex-direction: row;
        flex-wrap: wrap;
      }

      .identity-sidebar-bottom {
        margin-top: 10px;
      }

      .identity-topbar {
        padding: 0 15px;
      }

      .identity-content {
        padding: 15px;
      }

      .identity-portal-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .identity-verified-box {
        text-align: left;
      }

      .identity-search {
        max-width: 60%;
      }

      .identity-data-row {
        grid-template-columns: 1fr;
        padding: 10px 0;
        gap: 5px;
      }

      .identity-row-status {
        width: fit-content;
      }
    }
  </style>

</head>

<body>

  <div class="identity-dashboard">

    <aside class="identity-sidebar">

      <div class="identity-brand">

        <div class="identity-brand-icon">
          🏛️
        </div>

        <div>
          <h2>BharatSetu</h2>
          <p>One Citizen. One Platform.</p>
        </div>

      </div>


      <nav class="identity-nav">

        <a href="/dashboard?nationalId=<%= citizen.nationalId %>">
          🏠
          Home
        </a>

        <a href="/dashboard?nationalId=<%= citizen.nationalId %>#government-portals" class="active">
          🏛️
          Government Portals
        </a>

        <a href="/services?nationalId=<%= citizen.nationalId %>">
          📄
          Services & Applications
        </a>

        <a href="/portal/applicationStatus?nationalId=<%= citizen.nationalId %>">
          🕒
          Application History
        </a>

        <a href="#">
          ☑️
          Eligibility Checker
        </a>

        <a href="#">
          📁
          Document Reuse
        </a>

        <a href="#">
          🛡️
          Consent Management
        </a>

        <a href="#">
          🔍
          Grievance Management
        </a>

        <a href="#">
          🔔
          Notifications
        </a>

      </nav>


      <div class="identity-sidebar-bottom">

        <a href="/login" class="identity-nav">
          <span>🚪 Logout</span>
        </a>

      </div>

    </aside>


    <main class="identity-main">


      <header class="identity-topbar">

        <div class="identity-search">

          🔍

          <input
            type="text"
            placeholder="Search for services, schemes, certificates..."
          >

        </div>


        <div class="identity-user">

          <div class="identity-avatar">
            👤
          </div>

          <div>

            <strong>
              <%= citizen.identity.fullName %>
            </strong>

            <small>
              Citizen
            </small>

          </div>

        </div>

      </header>


      <div class="identity-content">


        <div class="identity-breadcrumb">

          Home
          <span>›</span>
          Government Portals
          <span>›</span>
          National Identity & Address Portal

        </div>


        <section class="identity-portal-header">

          <div class="identity-title-area">

            <div class="identity-title-icon">
              🪪
            </div>

            <div>

              <h1>
                National Identity & Address Portal
              </h1>

              <p>
                Verified citizen identity and address information
              </p>

            </div>

          </div>


          <div class="identity-verified-box">

            <span class="identity-verified-badge">
              ✓ Verified Government Data
            </span>

            <span class="identity-updated">
              Securely retrieved from verified records
            </span>

          </div>

        </section>


        <div class="identity-tabs">

          <a href="#" class="active">
            Overview
          </a>

          <a href="#">
            Data Details
          </a>

          <a href="#">
            Data Usage
          </a>

          <a href="#">
            Consent Log
          </a>

        </div>


        <div class="identity-layout">


          <div>


            <section class="identity-card">

              <div class="identity-card-title">

                <h2>
                  Identity Information
                </h2>

                <span class="identity-mini-verified">
                  ✓ Verified
                </span>

              </div>


              <div class="identity-data-row">

                <span class="identity-data-label">
                  Full Name
                </span>

                <strong class="identity-data-value">
                  <%= citizen.identity.fullName || "Not Available" %>
                </strong>

                <span class="identity-row-status">
                  ✓ Verified
                </span>

              </div>


              <div class="identity-data-row">

                <span class="identity-data-label">
                  National ID
                </span>

                <strong class="identity-data-value">
                  <%= citizen.nationalId || "Not Available" %>
                </strong>

                <span class="identity-row-status">
                  ✓ Verified
                </span>

              </div>


              <div class="identity-data-row">

                <span class="identity-data-label">
                  Date of Birth
                </span>

                <strong class="identity-data-value">

                  <%= citizen.identity.dob
                    ? new Date(citizen.identity.dob).toLocaleDateString()
                    : "Not Available"
                  %>

                </strong>

                <span class="identity-row-status">
                  ✓ Verified
                </span>

              </div>


              <div class="identity-data-row">

                <span class="identity-data-label">
                  Gender
                </span>

                <strong class="identity-data-value">
                  <%= citizen.identity.gender || "Not Available" %>
                </strong>

                <span class="identity-row-status">
                  ✓ Verified
                </span>

              </div>


              <div class="identity-data-row">

                <span class="identity-data-label">
                  Father's Name
                </span>

                <strong class="identity-data-value">
                  <%= citizen.identity.fatherName || "Not Available" %>
                </strong>

                <span class="identity-row-status">
                  ✓ Verified
                </span>

              </div>


              <div class="identity-info-box" style="margin-top: 15px;">

                <div class="identity-info-icon">
                  ℹ️
                </div>

                <div>
                  This information has been retrieved from the verified government identity records and can be securely reused for eligible government services.
                </div>

              </div>

            </section>


            <section class="identity-card">

              <div class="identity-card-title">

                <h2>
                  Address Information
                </h2>

                <span class="identity-mini-verified">
                  ✓ Verified
                </span>

              </div>


              <div class="identity-data-row">

                <span class="identity-data-label">
                  Registered Address
                </span>

                <strong class="identity-data-value">
                  <%= citizen.identity.address || "Not Available" %>
                </strong>

                <span class="identity-row-status">
                  ✓ Verified
                </span>

              </div>

            </section>


            <div class="identity-bottom">

              <span class="identity-security">
                🔐 Your verified information is protected and shared only with your consent.
              </span>

              <a
                href="/dashboard?nationalId=<%= citizen.nationalId %>"
                class="identity-back"
              >
                ← Back to Government Portals
              </a>

            </div>


          </div>


          <aside>


            <section class="identity-card identity-side-card">

              <h3>
                Department Information
              </h3>


              <div class="identity-department">

                <div class="identity-dept-icon">
                  🏛️
                </div>

                <div>

                  <strong>
                    National Identity Authority
                  </strong>

                  <span>
                    Government of India
                  </span>

                </div>

              </div>


              <p class="identity-side-text">
                This department manages verified identity and address information used for government services.
              </p>


              <a href="#" class="identity-side-button">
                🌐 Visit Official Portal ↗
              </a>

            </section>


            <section class="identity-card identity-side-card identity-consent">

              <h3>
                Data Sharing & Consent
              </h3>


              <span class="identity-consent-badge">
                🛡️ Consent Controlled
              </span>


              <p>
                Your identity information can be shared with eligible government services only according to your consent.
              </p>


              <a
                href="/services?nationalId=<%= citizen.nationalId %>"
                class="identity-side-button"
              >
                Manage Consent
              </a>

            </section>


            <section class="identity-card identity-side-card">

              <h3>
                Need Help?
              </h3>


              <p class="identity-side-text">
                Need assistance with your identity information or government services?
              </p>


              <a href="#" class="identity-side-button">
                🎧 Raise a Support Request
              </a>

            </section>


          </aside>


        </div>

      </div>

    </main>

  </div>

</body>

</html>