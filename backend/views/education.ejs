<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Educational Qualifications Registry</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    .education-dashboard {
      min-height: 100vh;
      background: #f3f6fb;
      display: flex;
      color: #172b4d;
    }

    .education-sidebar {
      width: 230px;
      background: #102f52;
      color: white;
      padding: 20px 14px;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      box-sizing: border-box;
    }

    .education-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 8px 24px;
    }

    .education-brand-icon {
      font-size: 30px;
    }

    .education-brand h2 {
      margin: 0;
      font-size: 20px;
    }

    .education-brand p {
      margin: 3px 0 0;
      font-size: 11px;
      opacity: 0.75;
    }

    .education-nav {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .education-nav a {
      color: white;
      text-decoration: none;
      padding: 11px 12px;
      border-radius: 8px;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 10px;
      opacity: 0.9;
    }

    .education-nav a:hover,
    .education-nav a.active {
      background: #1d5d99;
      opacity: 1;
    }

    .education-sidebar-bottom {
      margin-top: auto;
    }

    .education-main {
      flex: 1;
      min-width: 0;
    }

    .education-topbar {
      height: 64px;
      background: white;
      border-bottom: 1px solid #e3e8ef;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      box-sizing: border-box;
    }

    .education-search {
      width: 420px;
      max-width: 50%;
      background: #f5f7fa;
      border: 1px solid #e3e8ef;
      border-radius: 8px;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 9px;
      color: #7b8798;
      box-sizing: border-box;
    }

    .education-search input {
      border: none;
      outline: none;
      background: transparent;
      width: 100%;
      font-size: 12px;
    }

    .education-user {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .education-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #e8f0fa;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .education-user strong {
      display: block;
      font-size: 13px;
    }

    .education-user small {
      color: #7b8798;
      font-size: 11px;
    }

    .education-content {
      padding: 20px 28px 30px;
    }

    .education-breadcrumb {
      font-size: 11px;
      color: #7b8798;
      margin-bottom: 16px;
    }

    .education-breadcrumb span {
      margin: 0 5px;
    }

    .education-portal-header {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 12px;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 14px;
    }

    .education-title-area {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .education-title-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: #e9f3ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 27px;
    }

    .education-title-area h1 {
      margin: 0 0 5px;
      font-size: 20px;
    }

    .education-title-area p {
      margin: 0;
      font-size: 12px;
      color: #6c7a8c;
    }

    .education-verified-box {
      text-align: right;
    }

    .education-verified-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #e5f7ed;
      color: #16834b;
      padding: 7px 12px;
      border-radius: 18px;
      font-size: 11px;
      font-weight: 600;
    }

    .education-updated {
      display: block;
      margin-top: 6px;
      font-size: 10px;
      color: #7b8798;
    }

    .education-tabs {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 10px;
      padding: 0 18px;
      display: flex;
      gap: 25px;
      margin-bottom: 15px;
    }

    .education-tabs a {
      padding: 13px 2px;
      text-decoration: none;
      color: #66758a;
      font-size: 12px;
      border-bottom: 2px solid transparent;
    }

    .education-tabs a.active {
      color: #2365b5;
      border-bottom-color: #2365b5;
      font-weight: 600;
    }

    .education-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 16px;
    }

    .education-card {
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 12px;
      padding: 18px;
      margin-bottom: 16px;
    }

    .education-card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 15px;
    }

    .education-card-title h2 {
      margin: 0;
      font-size: 16px;
    }

    .education-mini-verified {
      background: #e7f7ed;
      color: #16834b;
      padding: 5px 9px;
      border-radius: 15px;
      font-size: 10px;
      font-weight: 600;
    }

    .education-record {
      border: 1px solid #edf0f4;
      border-radius: 10px;
      padding: 0 14px;
      margin-bottom: 14px;
    }

    .education-record:last-child {
      margin-bottom: 0;
    }

    .education-data-row {
      display: grid;
      grid-template-columns: 190px 1fr auto;
      align-items: center;
      min-height: 50px;
      border-bottom: 1px solid #edf0f4;
      gap: 12px;
    }

    .education-data-row:last-child {
      border-bottom: none;
    }

    .education-data-label {
      color: #68778d;
      font-size: 11px;
    }

    .education-data-value {
      font-size: 12px;
      font-weight: 600;
      color: #1d2e46;
    }

    .education-row-status {
      color: #16834b;
      font-size: 10px;
      font-weight: 600;
      background: #effaf3;
      padding: 5px 8px;
      border-radius: 12px;
    }

    .education-info-box {
      background: #eef6ff;
      border: 1px solid #d7e9fb;
      border-radius: 9px;
      padding: 11px 13px;
      display: flex;
      gap: 9px;
      color: #526b86;
      font-size: 10px;
      line-height: 1.5;
    }

    .education-info-icon {
      font-size: 15px;
    }

    .education-side-card h3 {
      margin: 0 0 15px;
      font-size: 14px;
    }

    .education-department {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 15px;
    }

    .education-dept-icon {
      width: 42px;
      height: 42px;
      border-radius: 8px;
      background: #f3f5f8;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    .education-department strong {
      display: block;
      font-size: 12px;
    }

    .education-department span {
      display: block;
      font-size: 10px;
      color: #718096;
      margin-top: 3px;
    }

    .education-side-text {
      font-size: 10px;
      color: #64748b;
      line-height: 1.5;
      margin-bottom: 14px;
    }

    .education-side-button {
      display: block;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      padding: 9px;
      border: 1px solid #b9c8da;
      border-radius: 7px;
      text-decoration: none;
      color: #2365b5;
      font-size: 10px;
      font-weight: 600;
    }

    .education-consent {
      background: #f1faf5;
      border-color: #d8eddf;
    }

    .education-consent-badge {
      display: inline-block;
      background: #e1f4e8;
      color: #16834b;
      padding: 5px 9px;
      border-radius: 14px;
      font-size: 10px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .education-consent p {
      font-size: 10px;
      color: #64748b;
      line-height: 1.5;
      margin: 0 0 13px;
    }

    .education-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      color: white;
      background: #2365b5;
      padding: 10px 16px;
      border-radius: 7px;
      font-size: 11px;
      font-weight: 600;
    }

    .education-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      background: white;
      border: 1px solid #e1e7ef;
      border-radius: 10px;
      padding: 12px 16px;
    }

    .education-security {
      font-size: 10px;
      color: #68778d;
    }

    .education-empty {
      padding: 25px;
      text-align: center;
      color: #718096;
      font-size: 12px;
      background: #f8fafc;
      border-radius: 8px;
    }

    @media (max-width: 900px) {
      .education-sidebar {
        width: 190px;
      }

      .education-layout {
        grid-template-columns: 1fr;
      }

      .education-search {
        width: 300px;
      }
    }

    @media (max-width: 650px) {
      .education-dashboard {
        display: block;
      }

      .education-sidebar {
        width: 100%;
        min-height: auto;
      }

      .education-nav {
        flex-direction: row;
        flex-wrap: wrap;
      }

      .education-sidebar-bottom {
        margin-top: 10px;
      }

      .education-topbar {
        padding: 0 15px;
      }

      .education-content {
        padding: 15px;
      }

      .education-portal-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .education-verified-box {
        text-align: left;
      }

      .education-search {
        max-width: 60%;
      }

      .education-data-row {
        grid-template-columns: 1fr;
        padding: 10px 0;
        gap: 5px;
      }

      .education-row-status {
        width: fit-content;
      }

      .education-record {
        padding: 0 10px;
      }

      .education-bottom {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>

  <div class="education-dashboard">

    <aside class="education-sidebar">

      <div class="education-brand">
        <div class="education-brand-icon">
          🏛️
        </div>

        <div>
          <h2>BharatSetu</h2>
          <p>One Citizen. One Platform.</p>
        </div>
      </div>

      <nav class="education-nav">

        <a href="/dashboard?nationalId=<%= citizen.nationalId %>">
          🏠
          Home
        </a>

        <a href="/dashboard?nationalId=<%= citizen.nationalId %>#government-portals" class="active">
          🏛️
          Government Portals
        </a>

        <a href="/services?nationalId=<%= citizen.nationalId %>">
          📄
          Services & Applications
        </a>

        <a href="/portal/applicationStatus?nationalId=<%= citizen.nationalId %>">
          🕒
          Application History
        </a>

        <a href="#">
          ☑️
          Eligibility Checker
        </a>

        <a href="#">
          📁
          Document Reuse
        </a>

        <a href="#">
          🛡️
          Consent Management
        </a>

        <a href="#">
          🔍
          Grievance Management
        </a>

        <a href="#">
          🔔
          Notifications
        </a>

      </nav>

      <div class="education-sidebar-bottom">

        <a href="/login" class="education-nav">
          <span>🚪 Logout</span>
        </a>

      </div>

    </aside>

    <main class="education-main">

      <header class="education-topbar">

        <div class="education-search">
          🔍
          <input
            type="text"
            placeholder="Search for services, schemes, certificates..."
          >
        </div>

        <div class="education-user">

          <div class="education-avatar">
            👤
          </div>

          <div>

            <strong>
              <%= citizen.identity.fullName %>
            </strong>

            <small>
              Citizen
            </small>

          </div>

        </div>

      </header>

      <div class="education-content">

        <div class="education-breadcrumb">
          Home
          <span>›</span>
          Government Portals
          <span>›</span>
          Educational Qualifications Registry
        </div>

        <section class="education-portal-header">

          <div class="education-title-area">

            <div class="education-title-icon">
              🎓
            </div>

            <div>

              <h1>
                Educational Qualifications Registry
              </h1>

              <p>
                Verified educational qualification records
              </p>

            </div>

          </div>

          <div class="education-verified-box">

            <span class="education-verified-badge">
              ✓ Verified Government Data
            </span>

            <span class="education-updated">
              Securely retrieved from verified records
            </span>

          </div>

        </section>

        <div class="education-tabs">

          <a href="#" class="active">
            Overview
          </a>

          <a href="#">
            Data Details
          </a>

          <a href="#">
            Data Usage
          </a>

          <a href="#">
            Consent Log
          </a>

        </div>

        <div class="education-layout">

          <div>

            <section class="education-card">

              <div class="education-card-title">

                <h2>
                  Education Information
                </h2>

                <span class="education-mini-verified">
                  ✓ Verified
                </span>

              </div>

              <% if (citizen.education && citizen.education.length > 0) { %>

                <% citizen.education.forEach(education => { %>

                  <div class="education-record">

                    <div class="education-data-row">

                      <span class="education-data-label">
                        Degree
                      </span>

                      <strong class="education-data-value">
                        <%= education.degree || "Not Available" %>
                      </strong>

                      <span class="education-row-status">
                        ✓ Verified
                      </span>

                    </div>

                    <div class="education-data-row">

                      <span class="education-data-label">
                        Institution
                      </span>

                      <strong class="education-data-value">
                        <%= education.institution || "Not Available" %>
                      </strong>

                      <span class="education-row-status">
                        ✓ Verified
                      </span>

                    </div>

                    <div class="education-data-row">

                      <span class="education-data-label">
                        Passing Year
                      </span>

                      <strong class="education-data-value">
                        <%= education.passingYear || "Not Available" %>
                      </strong>

                      <span class="education-row-status">
                        ✓ Verified
                      </span>

                    </div>

                    <div class="education-data-row">

                      <span class="education-data-label">
                        Grade / Percentage
                      </span>

                      <strong class="education-data-value">
                        <%= education.gradeOrPercentage || "Not Available" %>
                      </strong>

                      <span class="education-row-status">
                        ✓ Verified
                      </span>

                    </div>

                  </div>

                <% }) %>

              <% } else { %>

                <div class="education-empty">
                  No educational records available.
                </div>

              <% } %>

              <div class="education-info-box" style="margin-top: 15px;">

                <div class="education-info-icon">
                  ℹ️
                </div>

                <div>
                  This information has been retrieved from verified government education records and can be securely reused for eligible government services.
                </div>

              </div>

            </section>

            <section class="education-card">

              <div class="education-card-title">

                <h2>
                  Citizen Verification
                </h2>

                <span class="education-mini-verified">
                  ✓ Verified
                </span>

              </div>

              <div class="education-data-row">

                <span class="education-data-label">
                  Citizen Name
                </span>

                <strong class="education-data-value">
                  <%= citizen.identity.fullName || "Not Available" %>
                </strong>

                <span class="education-row-status">
                  ✓ Verified
                </span>

              </div>

              <div class="education-data-row">

                <span class="education-data-label">
                  National ID
                </span>

                <strong class="education-data-value">
                  <%= citizen.nationalId || "Not Available" %>
                </strong>

                <span class="education-row-status">
                  ✓ Verified
                </span>

              </div>

            </section>

            <div class="education-bottom">

              <span class="education-security">
                🔐 Your verified information is protected and shared only with your consent.
              </span>

              <a
                href="/dashboard?nationalId=<%= citizen.nationalId %>"
                class="education-back"
              >
                ← Back to Government Portals
              </a>

            </div>

          </div>

          <aside>

            <section class="education-card education-side-card">

              <h3>
                Department Information
              </h3>

              <div class="education-department">

                <div class="education-dept-icon">
                  🏛️
                </div>

                <div>

                  <strong>
                    Education Department
                  </strong>

                  <span>
                    Government of India
                  </span>

                </div>

              </div>

              <p class="education-side-text">
                This department manages verified educational qualification records used for scholarships, admissions and eligible government services.
              </p>

              <a href="#" class="education-side-button">
                🌐 Visit Official Portal ↗
              </a>

            </section>

            <section class="education-card education-side-card education-consent">

              <h3>
                Data Sharing & Consent
              </h3>

              <span class="education-consent-badge">
                🛡️ Consent Controlled
              </span>

              <p>
                Your education information can be shared with eligible government services only according to your consent.
              </p>

              <a
                href="/services?nationalId=<%= citizen.nationalId %>"
                class="education-side-button"
              >
                Manage Consent
              </a>

            </section>

            <section class="education-card education-side-card">

              <h3>
                Need Help?
              </h3>

              <p class="education-side-text">
                Need assistance with your education information or government services?
              </p>

              <a href="#" class="education-side-button">
                🎧 Raise a Support Request
              </a>

            </section>

          </aside>

        </div>

      </div>

    </main>

  </div>

</body>
</html>